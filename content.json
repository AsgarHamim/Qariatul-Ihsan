      "scripture.hero": "\u201cHelp one another in righteousness and piety.\u201d",
      "scripture.heroSrc": "\u2014 Surah Al-Ma'idah, 5:2",
      "scripture.about": "\u201cIt is He who has made you successors upon the earth.\u201d",
      "scripture.aboutSrc": "\u2014 Surah Fatir, 35:39",
      "scripture.begin": "\u201cThe most beloved of deeds to Allah are the most consistent, even if small.\u201d",
      "scripture.beginSrc": "\u2014 Bukhari",
      "scripture.agri": "\u201cHe it is who produces gardens\u2026 eat of their fruit when they ripen, and give its due on the day of harvest.\u201d",
      "scripture.agriSrc": "\u2014 Surah Al-An'am, 6:141",
      "scripture.animals": "\u201cWhoever is kind to God's creatures is kind to himself.\u201d",
      "scripture.animalsSrc": "\u2014 Abu Dawud 2858",
      "scripture.phil": "\u201cAllah has prescribed excellence (ihsan) in all things.\u201d",
      "scripture.philSrc": "\u2014 Sahih Muslim 1955",
      "scripture.store": "\u201cGive full measure and weight in justice.\u201d",
      "scripture.storeSrc": "\u2014 Surah Al-An'am, 6:152",
      "scripture.contact": "\u201cIndeed, Allah commands you to render trusts to whom they are due.\u201d",
      "scripture.contactSrc": "\u2014 Surah An-Nisa, 4:58",
