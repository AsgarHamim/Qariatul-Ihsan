      "nav.contact": "\u09af\u09cb\u0997\u09be\u09af\u09cb\u0997",
      "hero.eyebrow": "\u0988\u09ae\u09be\u09a8 \u00b7 \u09aa\u09cd\u09b0\u0995\u09c3\u09a4\u09bf \u00b7 \u09b8\u09ae\u09cd\u09aa\u09cd\u09b0\u09a6\u09be\u09af\u09bc",
      "hero.title": "\u0995\u09be\u09b0\u09bf\u09af\u09bc\u09be\u09a4\u09c1\u09b2 \u0987\u09b9\u09b8\u09be\u09a8",
      "hero.sub": "\u0988\u09ae\u09be\u09a8, \u09aa\u09cd\u09b0\u0995\u09c3\u09a4\u09bf \u0993 \u09b8\u09cd\u09ac\u09a8\u09bf\u09b0\u09cd\u09ad\u09b0 \u099c\u09c0\u09ac\u09a8\u09ac\u09cd\u09af\u09ac\u09b8\u09cd\u09a5\u09be\u09b0 \u098f\u0995\u099f\u09bf \u099c\u09c0\u09ac\u09a8\u09cd\u09a4 \u09b8\u09ae\u09cd\u09aa\u09cd\u09b0\u09a6\u09be\u09af\u09bc\u0964",
      "hero.cta1": "\u0995\u09be\u09b0\u09bf\u09af\u09bc\u09be\u09a4\u09c1\u09b2 \u0987\u09b9\u09b8\u09be\u09a8 \u0998\u09c1\u09b0\u09c7 \u09a6\u09c7\u0996\u09c1\u09a8",
      "hero.cta2": "\u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09b2\u0995\u09cd\u09b7\u09cd\u09af",
      "hero.scroll": "\u09b8\u09cd\u0995\u09cd\u09b0\u09b2 \u0995\u09b0\u09c1\u09a8",
      "about.eyebrow": "\u0995\u09be\u09b0\u09bf\u09af\u09bc\u09be\u09a4\u09c1\u09b2 \u0987\u09b9\u09b8\u09be\u09a8 \u0995\u09c0",
      "about.title": "\u09b6\u09c1\u09a7\u09c1 \u098f\u0995\u099f\u09bf \u0996\u09be\u09ae\u09be\u09b0, \u09ae\u09b8\u099c\u09bf\u09a6 \u09ac\u09be \u0997\u09cd\u09b0\u09be\u09ae \u09a8\u09af\u09bc \u2014 \u098f\u0995\u099f\u09bf \u09b8\u09ae\u09cd\u09aa\u09c2\u09b0\u09cd\u09a3 \u099c\u09c0\u09ac\u09a8\u09ac\u09cd\u09af\u09ac\u09b8\u09cd\u09a5\u09be\u0964",
      "about.sub": "\u0995\u09be\u09b0\u09bf\u09af\u09bc\u09be\u09a4\u09c1\u09b2 \u0987\u09b9\u09b8\u09be\u09a8 \u098f\u0995\u099f\u09bf \u0995\u09cd\u09b0\u09ae\u09ac\u09b0\u09cd\u09a7\u09ae\u09be\u09a8 \u09ac\u09be\u09b8\u09cd\u09a4\u09c1\u09a4\u09a8\u09cd\u09a4\u09cd\u09b0, \u09af\u09c7\u0996\u09be\u09a8\u09c7 \u0988\u09ae\u09be\u09a8, \u09b6\u09bf\u0995\u09cd\u09b7\u09be, \u09b8\u09cd\u09ac\u09be\u09b8\u09cd\u09a5\u09cd\u09af\u09b8\u09c7\u09ac\u09be, \u0995\u09c3\u09b7\u09bf, \u09b8\u09ae\u09cd\u09aa\u09cd\u09b0\u09a6\u09be\u09af\u09bc \u0993 \u09a8\u09c8\u09a4\u09bf\u0995 \u09ac\u09be\u09a3\u09bf\u099c\u09cd\u09af \u098f\u0995 \u09b8\u09c2\u09a4\u09cd\u09b0\u09c7 \u0997\u09be\u0981\u09a5\u09be\u0964",
      "about.c1t": "\u09ae\u09b8\u099c\u09bf\u09a6",
      "about.c1d": "\u09b8\u09ae\u09cd\u09aa\u09cd\u09b0\u09a6\u09be\u09af\u09bc\u09c7\u09b0 \u0986\u09a7\u09cd\u09af\u09be\u09a4\u09cd\u09ae\u09bf\u0995 \u0995\u09c7\u09a8\u09cd\u09a6\u09cd\u09b0, \u09a8\u09be\u09ae\u09be\u099c \u0993 \u099c\u09bf\u0995\u09bf\u09b0\u09c7\u09b0 \u09b8\u09cd\u09a5\u09be\u09a8\u0964",
      "about.c2t": "\u09ae\u09be\u09a6\u09cd\u09b0\u09be\u09b8\u09be",
      "about.c2d": "\u0987\u09b8\u09b2\u09be\u09ae\u09bf \u09b6\u09bf\u0995\u09cd\u09b7\u09be \u0993 \u099a\u09b0\u09bf\u09a4\u09cd\u09b0 \u0997\u09a0\u09a8\u09c7\u09b0 \u098f\u0995\u099f\u09bf \u09b8\u09cd\u09a5\u09be\u09a8\u0964",
      "about.c3t": "\u09b8\u09cd\u09ac\u09be\u09b8\u09cd\u09a5\u09cd\u09af\u09b8\u09c7\u09ac\u09be",
      "about.c3d": "\u09ae\u09b0\u09cd\u09af\u09be\u09a6\u09be \u0993 \u09b8\u09b9\u09be\u09a8\u09c1\u09ad\u09c2\u09a4\u09bf\u09b0 \u09b8\u09be\u09a5\u09c7 \u0997\u09a1\u09bc\u09be, \u09b8\u09ac\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u09b8\u09b9\u099c\u09b2\u09ad\u09cd\u09af \u099a\u09bf\u0995\u09bf\u09ce\u09b8\u09be\u0964",
      "about.c4t": "\u0995\u09c3\u09b7\u09bf",
      "about.c4d": "\u098f\u09ae\u09a8 \u099c\u09ae\u09bf \u09af\u09be \u09b8\u09ae\u09cd\u09aa\u09cd\u09b0\u09a6\u09be\u09af\u09bc\u09c7\u09b0 \u0996\u09be\u09a6\u09cd\u09af \u09af\u09cb\u0997\u09be\u09af\u09bc \u2014 \u09ab\u09b8\u09b2, \u09ab\u09b2, \u09ae\u09be\u099b \u0993 \u0997\u09ac\u09be\u09a6\u09bf\u09aa\u09b6\u09c1\u0964",
      "about.c5t": "\u09b8\u09ae\u09cd\u09aa\u09cd\u09b0\u09a6\u09be\u09af\u09bc",
      "about.c5d": "\u098f\u09ae\u09a8 \u0998\u09b0 \u0993 \u09ad\u09be\u0997\u09be\u09ad\u09be\u0997\u09bf\u09b0 \u099c\u09be\u09af\u09bc\u0997\u09be \u09af\u09c7\u0996\u09be\u09a8\u09c7 \u09aa\u09b0\u09bf\u09ac\u09be\u09b0\u0997\u09c1\u09b2\u09cb \u098f\u0995\u09b8\u09be\u09a5\u09c7 \u09ac\u09be\u0981\u099a\u09c7, \u09b6\u09c7\u0996\u09c7 \u0993 \u09ac\u09c7\u09a1\u09bc\u09c7 \u0993\u09a0\u09c7\u0964",
      "about.c6t": "\u09a8\u09c8\u09a4\u09bf\u0995 \u09ac\u09be\u09a3\u09bf\u099c\u09cd\u09af",
      "about.c6d": "\u098f\u0995\u099f\u09bf \u09b6\u09b9\u09b0\u09ad\u09bf\u09a4\u09cd\u09a4\u09bf\u0995 \u09a6\u09cb\u0995\u09be\u09a8, \u09af\u09be \u099c\u09ae\u09bf\u09b0 \u0989\u09ce\u09aa\u09be\u09a6\u09a8 \u09ae\u09be\u09a8\u09c1\u09b7\u09c7\u09b0 \u0995\u09be\u099b\u09c7 \u09aa\u09cc\u0981\u099b\u09c7 \u09a6\u09c7\u09af\u09bc\u0964",
      "begin.eyebrow": "\u098f\u0995\u099f\u09bf \u099b\u09cb\u099f \u09b8\u09c2\u099a\u09a8\u09be \u09a5\u09c7\u0995\u09c7",
      "begin.title": "\u099b\u09cb\u099f \u098f\u0995 \u09b6\u09c1\u09b0\u09c1, \u09a7\u09c0\u09b0\u09c7 \u09a7\u09c0\u09b0\u09c7 \u09aa\u09c2\u09b0\u09cd\u09a3\u09be\u0999\u09cd\u0997 \u09b8\u09ae\u09cd\u09aa\u09cd\u09b0\u09a6\u09be\u09af\u09bc\u09c7 \u09aa\u09b0\u09bf\u09a3\u09a4 \u09b9\u099a\u09cd\u099b\u09c7\u0964",
      "begin.sub": "\u0986\u099c \u0995\u09be\u09b0\u09bf\u09af\u09bc\u09be\u09a4\u09c1\u09b2 \u0987\u09b9\u09b8\u09be\u09a8 \u099b\u09cb\u099f \u0993 \u09ac\u09be\u09b8\u09cd\u09a4\u09ac\u0964 \u0986\u0997\u09be\u09ae\u09c0\u0995\u09be\u09b2 \u098f\u099f\u09bf \u09aa\u09c2\u09b0\u09cd\u09a3\u09a4\u09be \u09aa\u09be\u09ac\u09c7\u0964 \u09a6\u09c1\u099f\u09cb\u0987 \u0997\u09c1\u09b0\u09c1\u09a4\u09cd\u09ac\u09aa\u09c2\u09b0\u09cd\u09a3\u0964",
