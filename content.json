      "brand.name": "\u0995\u09be\u09b0\u09bf\u09af\u09bc\u09be\u09a4\u09c1\u09b2 \u0987\u09b9\u09b8\u09be\u09a8",
      "nav.home": "\u09b9\u09cb\u09ae",
      "nav.about": "\u09aa\u09b0\u09bf\u099a\u09bf\u09a4\u09bf",
